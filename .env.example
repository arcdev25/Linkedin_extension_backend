# Copy to .env and fill in. NEVER commit .env, and never put the service key
# anywhere the extension can reach it.

# Supabase → Settings → API → Project URL
SUPABASE_URL=https://iotxnqhegxxjrvdkonyu.supabase.co

# Supabase → Settings → API Keys.
#
# Prefer a NEW-STYLE secret key (sb_secret_...) over the legacy service_role
# JWT: the legacy keys are deprecated by the end of 2026, and a secret key is
# additionally refused if it's ever used from a browser. Both formats work —
# the code detects which you supplied and sets the right headers.
#
# This key bypasses Row Level Security. It belongs on this server only: never
# in the extension, the dashboard bundle, or a git commit.
SUPABASE_SERVICE_KEY=

PORT=8080

# Origins allowed to call this API. Comma-separated, no spaces.
# Leave empty in local dev to accept any origin.
#
# The extension ID below is FIXED by the "key" field in the extension's
# manifest.json, so it is identical on every machine and every Chromium
# browser. Without that key field, Chrome derives the ID from the folder path,
# and each teammate would get a different one.
ALLOWED_ORIGINS=chrome-extension://obdehkgoafhgmkbgiapbaehgkibhepnj,https://linkedin-profile-checker-extension-indol.vercel.app

# Days before a login expires.
SESSION_TTL_DAYS=30

# 'global' — everyone signed in sees every recruiter's contacts (old behaviour)
# 'owner'  — each owner sees only their own recruiters' contacts
CONTACT_SCOPE=global

# Google Apps Script blocklist endpoint (optional; leave blank to disable)
BLOCKLIST_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwzzEBS8iI7zYVmEzHKrtqq53-SmSf8Qw5Cb3FSZakHdAjiS_Oi4DlTJiA5nU9x20bA3w/exec
