# Copy to .env and fill in. NEVER commit .env, and never put the service key
# anywhere the extension can reach it.

# Supabase → Settings → API → Project URL
SUPABASE_URL=https://iotxnqhegxxjrvdkonyu.supabase.co

# Supabase → Settings → API → service_role key (SECRET).
# This key bypasses Row Level Security. It belongs on this server only.
SUPABASE_SERVICE_KEY=

PORT=8080

# Your unpacked extension's ID, from chrome://extensions.
# Comma-separated. Leave empty in local dev to accept any origin.
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# Days before a login expires.
SESSION_TTL_DAYS=30

# 'global' — everyone signed in sees every recruiter's contacts (old behaviour)
# 'owner'  — each owner sees only their own recruiters' contacts
CONTACT_SCOPE=global

# Google Apps Script blocklist endpoint (optional; leave blank to disable)
BLOCKLIST_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwzzEBS8iI7zYVmEzHKrtqq53-SmSf8Qw5Cb3FSZakHdAjiS_Oi4DlTJiA5nU9x20bA3w/exec
